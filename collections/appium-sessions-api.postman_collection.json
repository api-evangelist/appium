            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"capabilities\": {\n    \"alwaysMatch\": \"<object>\",\n    \"firstMatch\": [\n      \"<object>\",\n      \"<object>\"\n    ]\n  }\n}",
