{
  "opencollection": "1.0.0",
  "info": {
    "name": "Appium Server Actions Cookies API",
    "version": "2.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Cookies",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Appium Get All Cookies",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:4723/session/:sessionId/cookie",
            "params": [
              {
                "name": "sessionId",
                "value": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                "type": "path",
                "description": "The unique session identifier"
              }
            ]
          },
          "docs": "Returns all cookies visible to the current page."
        }
      ]
    }
  ],
  "bundled": true
}