{
  "opencollection": "1.0.0",
  "info": {
    "name": "Appium Server Actions Elements API",
    "version": "2.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Elements",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Appium Find Element",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:4723/session/:sessionId/element",
            "params": [
              {
                "name": "sessionId",
                "value": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                "type": "path",
                "description": "The unique session identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Finds the first element matching a given locator strategy and selector."
        },
        {
          "info": {
            "name": "Appium Find Elements",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:4723/session/:sessionId/elements",
            "params": [
              {
                "name": "sessionId",
                "value": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                "type": "path",
                "description": "The unique session identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Finds all elements matching a given locator strategy and selector."
        },
        {
          "info": {
            "name": "Appium Click Element",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:4723/session/:sessionId/element/:elementId/click",
            "params": [
              {
                "name": "sessionId",
                "value": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                "type": "path",
                "description": "The unique session identifier"
              },
              {
                "name": "elementId",
                "value": "1234567890",
                "type": "path",
                "description": "The unique element identifier within the session"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Clicks on the specified element."
        },
        {
          "info": {
            "name": "Appium Send Keys to Element",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:4723/session/:sessionId/element/:elementId/value",
            "params": [
              {
                "name": "sessionId",
                "value": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                "type": "path",
                "description": "The unique session identifier"
              },
              {
                "name": "elementId",
                "value": "1234567890",
                "type": "path",
                "description": "The unique element identifier within the session"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Sends text input to the specified element."
        },
        {
          "info": {
            "name": "Appium Get Element Text",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:4723/session/:sessionId/element/:elementId/text",
            "params": [
              {
                "name": "sessionId",
                "value": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                "type": "path",
                "description": "The unique session identifier"
              },
              {
                "name": "elementId",
                "value": "1234567890",
                "type": "path",
                "description": "The unique element identifier within the session"
              }
            ]
          },
          "docs": "Returns the visible text of the specified element."
        },
        {
          "info": {
            "name": "Appium Get Page Source",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:4723/session/:sessionId/source",
            "params": [
              {
                "name": "sessionId",
