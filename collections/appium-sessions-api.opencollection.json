{
  "opencollection": "1.0.0",
  "info": {
    "name": "Appium Server Actions Sessions API",
    "version": "2.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Sessions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Appium Create Session",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:4723/session",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new WebDriver/Appium automation session with the given capabilities."
        },
        {
          "info": {
            "name": "Appium Delete Session",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "http://localhost:4723/session/:sessionId",
            "params": [
              {
                "name": "sessionId",
                "value": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                "type": "path",
                "description": "The unique session identifier"
              }
            ]
          },
          "docs": "Ends the current automation session and releases all associated resources."
        }
      ]
    }
  ],
  "bundled": true
